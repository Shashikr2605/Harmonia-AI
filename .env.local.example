# ---------------------------------------------------------------------------
# Local development env for Harmonia AI  →  copy to .env
#   cp .env.local.example .env
# ---------------------------------------------------------------------------
# Fully self-contained: no Supabase / Cloudflare accounts needed.
# Postgres, Redis, MinIO storage, and the S3 endpoint wiring are all provided
# by docker-compose.yml — you do NOT need to set DATABASE_URL or R2_* here for
# local dev (compose overrides them to point at the local containers).
#
# The defaults below work as-is. Change JWT_SECRET to any random string if you
# want; for local dev the value only needs to be consistent across restarts.
# ---------------------------------------------------------------------------

# ── Auth ───────────────────────────────────────────────────────────────────
# Local email/password auth mints HS256 JWTs signed with this secret
# (backend/app/api/v1/auth_endpoint.py) which backend/app/auth.py verifies.
# For local dev any non-empty string works. Generate a strong one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-insecure-change-me-0123456789abcdef

# ── App settings ───────────────────────────────────────────────────────────
# Must include the exact frontend origin or browser calls fail CORS preflight.
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100

# ── Optional ───────────────────────────────────────────────────────────────
# App runs fine without this — it's only for the (not-yet-wired) RAG copilot.
# ANTHROPIC_API_KEY=sk-ant-...
