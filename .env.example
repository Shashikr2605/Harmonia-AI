# ============================================================
# SUPABASE — Postgres + pgvector + Auth
# Get these from Supabase dashboard → Project Settings → API / Database
# ============================================================
# Use the "Session pooler" connection string (port 6543), not the direct
# connection — free-tier Postgres has very few direct connection slots,
# and Celery workers + FastAPI will exhaust them fast otherwise.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # backend only — never ship this to the frontend

# From Supabase → Project Settings → API → JWT Secret
# NOTE: Most Supabase projects use HS256 (this secret).  If your project
# has switched to asymmetric ES256 signing, update auth.py accordingly.
JWT_SECRET=your-jwt-signing-secret

# ============================================================
# CLOUDFLARE R2 — object storage for uploads, stems, mixes
# R2 is S3-compatible, so the same boto3 client works — just point it here.
# Get these from Cloudflare dashboard → R2 → Manage API Tokens
# ============================================================
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=harmonia-audio
R2_ENDPOINT_URL=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Optional: a public R2.dev or custom domain, if you serve stems directly
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# IMPORTANT — R2 bucket CORS policy (set in Cloudflare dashboard, NOT here)
# The frontend uploads audio files directly from the browser to R2 via
# presigned PUT URLs.  This is a cross-origin request from your Vercel domain
# to *.r2.cloudflarestorage.com, so you must add a CORS policy on the bucket:
#   Cloudflare dashboard → R2 → harmonia-audio → Settings → CORS Policy
#   Allow: PUT, GET, OPTIONS from https://harmonia-ai.vercel.app + http://localhost:3000
# Without this, browser uploads silently fail with an opaque CORS error.

# ============================================================
# ORACLE VM — where this compose stack itself runs
# ============================================================
N8N_HOST=n8n.yourdomain.com
TZ=Asia/Kolkata

# n8n internal secrets — generate each with: openssl rand -hex 32
# Do NOT use these placeholder comments as actual values.
N8N_ENCRYPTION_KEY=   # openssl rand -hex 32
N8N_USER_MANAGEMENT_JWT_SECRET=   # openssl rand -hex 32

# ============================================================
# APP SETTINGS
# ============================================================
LOG_LEVEL=INFO
# MAX_UPLOAD_SIZE_MB is returned by GET /api/v1/config and used by the
# frontend to validate file size before starting the upload flow.
# The API itself never proxies audio files, so this is advisory only.
MAX_UPLOAD_SIZE_MB=100

# ============================================================
# LLM / embeddings for the RAG copilot
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...   # optional — app runs without it
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # runs locally, no API cost

# ============================================================
# CORS — so the Vercel-hosted frontend can call this API
# CRITICAL: this must include the EXACT Vercel production URL.
# A trailing slash or wrong subdomain causes silent CORS failures.
# ============================================================
ALLOWED_ORIGINS=https://harmonia-ai.vercel.app,http://localhost:3000

